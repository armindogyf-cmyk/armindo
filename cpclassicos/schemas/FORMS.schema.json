{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://cpclassicos.local/schemas/FORMS.schema.json",
 "title":"CP Clássicos — Form Schemas",
 "type":"object",
 "$defs":{
  "vehicleMaster":{"type":"object","additionalProperties":false,"required":["cpVehicleCode","manufacturer","model","status"],"properties":{"cpVehicleCode":{"type":"string"},"vin":{"type":["string","null"],"minLength":17,"maxLength":17},"registration":{"type":["string","null"]},"manufacturer":{"type":"string"},"model":{"type":"string"},"generation":{"type":["string","null"]},"modelYear":{"type":["integer","null"],"minimum":1886,"maximum":2100},"market":{"type":["string","null"]},"status":{"$ref":"#/$defs/recordStatus"}}},
  "vehicleConfiguration":{"type":"object","additionalProperties":false,"properties":{"engineCode":{"type":["string","null"]},"engineFamily":{"type":["string","null"]},"displacementCc":{"type":["integer","null"],"minimum":1},"fuelType":{"type":["string","null"]},"gearboxCode":{"type":["string","null"]},"gearboxType":{"type":["string","null"]},"absVariant":{"type":["string","null"]},"emissionsVariant":{"type":["string","null"]},"ecuHw":{"type":["string","null"]},"ecuSw":{"type":["string","null"]},"status":{"$ref":"#/$defs/recordStatus"},"confidence":{"type":["number","null"],"minimum":0,"maximum":100}}},
  "part":{"type":"object","additionalProperties":false,"required":["cpPartId","systemId","componentName","status"],"properties":{"cpPartId":{"type":"string","pattern":"^CP-[A-Z0-9-]+$"},"systemId":{"type":"string","format":"uuid"},"subsystem":{"type":"string"},"componentName":{"type":"string","minLength":2},"position":{"type":"string"},"criticality":{"$ref":"#/$defs/severity"},"theoreticalQty":{"type":"number","minimum":0},"unit":{"type":"string"},"status":{"$ref":"#/$defs/recordStatus"}}},
  "partIdentifier":{"type":"object","additionalProperties":false,"required":["partId","brand","partNumber","identifierType","status"],"properties":{"partId":{"type":"string","format":"uuid"},"brand":{"type":"string"},"partNumber":{"type":"string","minLength":1},"identifierType":{"enum":["OEM","IAM","SUPPLIER","INTERNAL"]},"market":{"type":"string"},"catalogue":{"type":"string"},"catalogueVersion":{"type":"string"},"status":{"$ref":"#/$defs/recordStatus"}}},
  "fitmentReview":{"type":"object","additionalProperties":false,"required":["partId","vehicleConfigurationId","decision","rationale"],"properties":{"partId":{"type":"string","format":"uuid"},"partIdentifierId":{"type":["string","null"],"format":"uuid"},"vehicleConfigurationId":{"type":"string","format":"uuid"},"decision":{"enum":["QUARANTINE","CANDIDATE","CONFIRMED","REJECTED","SUPERSEDED"]},"confidence":{"type":"number","minimum":0,"maximum":100},"sourceAssertionId":{"type":["string","null"],"format":"uuid"},"rationale":{"type":"string","minLength":3},"reviewedBy":{"type":"string"}}},
  "fault":{"type":"object","additionalProperties":false,"required":["vehicleId","faultCode","symptom","severity"],"properties":{"vehicleId":{"type":"string","format":"uuid"},"faultCode":{"type":"string","pattern":"^CP-F-[0-9]{4,}$"},"symptom":{"type":"string","minLength":3},"description":{"type":"string"},"severity":{"$ref":"#/$defs/severity"},"dtcs":{"type":"array","items":{"type":"string"}}}},
  "diagnosticNode":{"type":"object","additionalProperties":false,"required":["caseId","nodeType","title"],"properties":{"caseId":{"type":"string","format":"uuid"},"nodeType":{"enum":["SYMPTOM","HYPOTHESIS","TEST","OBSERVATION","CONCLUSION","CORRECTIVE_ACTION"]},"title":{"type":"string"},"body":{"type":"string"},"expectedValue":{},"actualValue":{},"unit":{"type":"string"},"evidenceAssetIds":{"type":"array","items":{"type":"string","format":"uuid"}}}},
  "workOrder":{"type":"object","additionalProperties":false,"required":["workOrderCode","vehicleId","status"],"properties":{"workOrderCode":{"type":"string","pattern":"^CP-OS-[0-9]{4,}$"},"vehicleId":{"type":"string","format":"uuid"},"faultId":{"type":["string","null"],"format":"uuid"},"procedureId":{"type":["string","null"],"format":"uuid"},"odometerKm":{"type":["integer","null"],"minimum":0},"responsible":{"type":"string"},"workshop":{"type":"string"},"priority":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"status":{"enum":["DRAFT","TECHNICAL_REVIEW","APPROVED","IN_PROGRESS","QA","CLOSED","BLOCKED","CANCELLED"]},"notes":{"type":"string"}}},
  "workOrderClose":{"type":"object","additionalProperties":false,"required":["workOrderId","qaResult","evidenceComplete","checksComplete"],"properties":{"workOrderId":{"type":"string","format":"uuid"},"qaResult":{"enum":["PASS","FAIL"]},"evidenceComplete":{"const":true},"checksComplete":{"const":true},"staticTest":{"type":"string"},"roadTest":{"type":"string"},"postRepairDtcs":{"type":"array","items":{"type":"string"}},"observations":{"type":"string"}}},
  "evidenceUpload":{"type":"object","additionalProperties":false,"required":["projectId","kind","originalFilename","mimeType","sha256"],"properties":{"projectId":{"type":"string","format":"uuid"},"vehicleId":{"type":["string","null"],"format":"uuid"},"kind":{"enum":["PHOTO","DOCUMENT","SCAN","MEASUREMENT","SCREENSHOT","VIDEO","AUDIO","OTHER"]},"originalFilename":{"type":"string"},"mimeType":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"capturedAt":{"type":["string","null"],"format":"date-time"},"description":{"type":"string"}}},
  "annotation":{"type":"object","additionalProperties":false,"required":["assetId","geometryType","geometry","label"],"properties":{"assetId":{"type":"string","format":"uuid"},"geometryType":{"enum":["POINT","BOX","POLYGON"]},"geometry":{"type":"object"},"label":{"type":"string"},"partId":{"type":["string","null"],"format":"uuid"},"confidence":{"type":"number","minimum":0,"maximum":100}}},
  "source":{"type":"object","additionalProperties":false,"required":["sourceCode","issuer","name","grade"],"properties":{"sourceCode":{"type":"string","pattern":"^SRC-[A-Z0-9-]+$"},"issuer":{"type":"string"},"name":{"type":"string"},"grade":{"enum":["A","B","C","D"]},"kind":{"type":"string"},"uri":{"type":"string","format":"uri"},"licence":{"type":"string"},"permittedUse":{"type":"string"}}},
  "sourceAssertion":{"type":"object","additionalProperties":false,"required":["sourceId","subjectType","subjectId","predicate","value"],"properties":{"sourceId":{"type":"string","format":"uuid"},"subjectType":{"type":"string"},"subjectId":{"type":"string","format":"uuid"},"predicate":{"type":"string","minLength":2},"value":{},"confidence":{"type":"number","minimum":0,"maximum":100},"status":{"enum":["QUARANTINE","CANDIDATE","CONFIRMED","REJECTED","SUPERSEDED"]},"supersedesId":{"type":["string","null"],"format":"uuid"},"checkedBy":{"type":"string"}}},
  "recallCheck":{"type":"object","additionalProperties":false,"required":["vehicleId","checkedAt","identifierType","identifierValue","result","sourceId"],"properties":{"vehicleId":{"type":"string","format":"uuid"},"checkedAt":{"type":"string","format":"date-time"},"identifierType":{"enum":["VIN","REGISTRATION"]},"identifierValue":{"type":"string"},"result":{"enum":["NO_ACTIVE_RECALL","ACTIVE_RECALL","UNKNOWN","CHECK_FAILED"]},"sourceId":{"type":"string","format":"uuid"},"evidenceAssetId":{"type":["string","null"],"format":"uuid"},"checkedBy":{"type":"string"}}},
  "recordStatus":{"enum":["DRAFT","QUARANTINE","CANDIDATE","CONFIRMED","REJECTED","SUPERSEDED","ARCHIVED"]},
  "severity":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]}
 },
 "properties":{
   "vehicleMaster":{"$ref":"#/$defs/vehicleMaster"},
   "vehicleConfiguration":{"$ref":"#/$defs/vehicleConfiguration"},
   "part":{"$ref":"#/$defs/part"},
   "partIdentifier":{"$ref":"#/$defs/partIdentifier"},
   "fitmentReview":{"$ref":"#/$defs/fitmentReview"},
   "fault":{"$ref":"#/$defs/fault"},
   "diagnosticNode":{"$ref":"#/$defs/diagnosticNode"},
   "workOrder":{"$ref":"#/$defs/workOrder"},
   "workOrderClose":{"$ref":"#/$defs/workOrderClose"},
   "evidenceUpload":{"$ref":"#/$defs/evidenceUpload"},
   "annotation":{"$ref":"#/$defs/annotation"},
   "source":{"$ref":"#/$defs/source"},
   "sourceAssertion":{"$ref":"#/$defs/sourceAssertion"},
   "recallCheck":{"$ref":"#/$defs/recallCheck"}
 }
}
