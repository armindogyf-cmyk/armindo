{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cpclassicos.local/schemas/MANUAL_TEMPLATE.schema.json",
  "title":"CP Clássicos — Manual Executável",
  "description":"Canonical source model for workshop procedures. PDF/PPT/HTML are render outputs, not the system of record.",
  "type":"object",
  "additionalProperties":false,
  "required":["procedureCode","title","version","system","objective","applicability","risk","prerequisites","tools","parts","steps","finalVerification","sources","governance"],
  "properties":{
    "procedureCode":{"type":"string","pattern":"^M[0-9]{2}-[0-9]{2,}$"},
    "title":{"type":"string","minLength":5},
    "version":{"type":"string","minLength":1},
    "language":{"const":"pt-PT"},
    "system":{"type":"object","required":["code","name"],"properties":{"code":{"type":"string"},"name":{"type":"string"}},"additionalProperties":false},
    "objective":{"type":"string","minLength":10},
    "applicability":{"type":"object","required":["vehicleScope","configurationStatus"],"properties":{"vehicleScope":{"type":"array","minItems":1,"items":{"type":"string"}},"configurationStatus":{"enum":["CONFIRMED","PARTIAL","PENDING"]},"constraints":{"type":"array","items":{"type":"string"}},"excludedConfigurations":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "risk":{"type":"object","required":["level","warnings","stopCriteria"],"properties":{"level":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"warnings":{"type":"array","items":{"type":"string"}},"stopCriteria":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "prerequisites":{"type":"array","items":{"$ref":"#/$defs/prerequisite"}},
    "tools":{"type":"array","items":{"$ref":"#/$defs/toolRequirement"}},
    "parts":{"type":"array","items":{"$ref":"#/$defs/partRequirement"}},
    "technicalInformation":{"type":"array","items":{"$ref":"#/$defs/technicalDatum"}},
    "preparation":{"type":"array","items":{"type":"string"}},
    "steps":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/step"}},
    "finalVerification":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/check"}},
    "firstStartOrRoadTest":{"type":"array","items":{"type":"string"}},
    "failurePath":{"type":"array","items":{"type":"string"}},
    "registration":{"type":"object","properties":{"fields":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}},"additionalProperties":false},
    "sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceRef"}},
    "governance":{"$ref":"#/$defs/governance"}
  },
  "$defs":{
    "prerequisite":{"type":"object","required":["description","required"],"properties":{"description":{"type":"string"},"required":{"type":"boolean"},"verification":{"type":"string"}},"additionalProperties":false},
    "toolRequirement":{"type":"object","required":["name","required","quantity"],"properties":{"toolId":{"type":"string"},"name":{"type":"string"},"required":{"type":"boolean"},"quantity":{"type":"number","exclusiveMinimum":0},"calibrationRequired":{"type":"boolean"},"notes":{"type":"string"}},"additionalProperties":false},
    "partRequirement":{"type":"object","required":["name","quantity","requiredFitmentStatus"],"properties":{"partId":{"type":"string"},"identifier":{"type":"string"},"name":{"type":"string"},"quantity":{"type":"number","exclusiveMinimum":0},"requiredFitmentStatus":{"enum":["CANDIDATE","CONFIRMED"]},"notes":{"type":"string"}},"additionalProperties":false},
    "technicalDatum":{"type":"object","required":["name","value","validationStatus"],"properties":{"name":{"type":"string"},"value":{},"unit":{"type":"string"},"validationStatus":{"enum":["PENDING","CANDIDATE","CONFIRMED"]},"sourceAssertionId":{"type":"string"}},"additionalProperties":false},
    "check":{"type":"object","required":["prompt","responseType","required"],"properties":{"prompt":{"type":"string"},"responseType":{"enum":["BOOLEAN","TEXT","NUMBER","CHOICE","PHOTO","MEASUREMENT"]},"required":{"type":"boolean"},"expectedValue":{},"unit":{"type":"string"},"failureAction":{"type":"string"}},"additionalProperties":false},
    "evidenceRequirement":{"type":"object","required":["kind","required","description"],"properties":{"kind":{"enum":["PHOTO","DOCUMENT","SCAN","MEASUREMENT","SCREENSHOT","VIDEO","OTHER"]},"required":{"type":"boolean"},"description":{"type":"string"},"annotationLabels":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "step":{"type":"object","additionalProperties":false,"required":["stepId","sequence","phase","title","instruction","acceptanceCriteria","checks","evidence"],"properties":{"stepId":{"type":"string","pattern":"^[A-Z0-9-]+$"},"sequence":{"type":"integer","minimum":1},"phase":{"type":"string"},"title":{"type":"string"},"objective":{"type":"string"},"instruction":{"type":"string","minLength":5},"visual":{"type":"object","properties":{"assetId":{"type":"string"},"caption":{"type":"string"},"annotations":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},"warning":{"type":"string"},"tools":{"type":"array","items":{"type":"string"}},"parts":{"type":"array","items":{"type":"string"}},"acceptanceCriteria":{"type":"string","minLength":3},"checks":{"type":"array","items":{"$ref":"#/$defs/check"}},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidenceRequirement"}},"nextStep":{"type":["string","null"]},"stopIf":{"type":"array","items":{"type":"string"}}}},
    "sourceRef":{"type":"object","required":["sourceId","grade","purpose"],"properties":{"sourceId":{"type":"string"},"grade":{"enum":["A","B","C","D"]},"purpose":{"type":"string"},"assertionIds":{"type":"array","items":{"type":"string"}},"licenceChecked":{"type":"boolean"}},"additionalProperties":false},
    "governance":{"type":"object","additionalProperties":false,"required":["status","author","technicalReviewRequired","changeLog"],"properties":{"status":{"enum":["DRAFT","TECHNICAL_REVIEW","PUBLISHED","SUPERSEDED","ARCHIVED"]},"author":{"type":"string"},"reviewer":{"type":"string"},"technicalReviewRequired":{"type":"boolean"},"publishedAt":{"type":["string","null"],"format":"date-time"},"supersedes":{"type":["string","null"]},"changeLog":{"type":"array","items":{"type":"object","required":["version","date","change"],"properties":{"version":{"type":"string"},"date":{"type":"string","format":"date"},"change":{"type":"string"},"author":{"type":"string"}},"additionalProperties":false}}}}
  }
}
